DATABASE_URL="postgresql://helpdesk:helpdesk@localhost:5433/helpdesk?schema=public"
PORT=4000

# Set to "production" when deploying. Nothing security-critical is keyed off it:
# session cookies follow BETTER_AUTH_URL's scheme and rate limiting is always on, both
# so that a .env copied forward with this left at "development" cannot weaken them.
NODE_ENV="development"

# Required. Generate with: openssl rand -base64 32
# Must be at least 32 chars. The server refuses to boot if this is empty, since
# Better Auth would otherwise fall back to a default secret published on npm.
BETTER_AUTH_SECRET=""

# Required. The origin this API is reached at. Better Auth derives the session cookie's
# Secure flag from the scheme, so any host other than localhost/127.0.0.1 must be
# https:// — the server refuses to boot otherwise.
BETTER_AUTH_URL="http://localhost:4000"

# How far to trust X-Forwarded-For. Leave unset when nothing fronts the API: the client
# IP then comes from the socket, which a caller cannot forge, and rate-limit buckets stay
# per-client. Behind a proxy set the number of hops it adds (usually 1), a comma-separated
# list of proxy addresses, or an Express preset such as "loopback". "true" is rejected at
# boot: trusting every hop hands X-Forwarded-For, and so req.ip, back to the caller.
TRUST_PROXY=""

# Browser origins allowed to call the API (comma-separated).
# Also used as Better Auth trustedOrigins. Required — the server refuses to boot if empty.
CORS_ORIGINS="http://localhost:5173"

# Read by prisma/seed.ts, which creates the admin account and nothing else. Agent
# accounts are created by an admin from the app, so they have no variables here.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
