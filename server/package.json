{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "db:seed": "bun prisma/seed.ts",
    "db:test:create": "bun prisma/test-db.ts create",
    "db:test:migrate": "bunx --bun prisma migrate deploy",
    "db:test:seed": "bun prisma/seed-test.ts",
    "db:test:drop": "bun prisma/test-db.ts drop",
    "db:test:reset": "bun run db:test:drop && bun run db:test:create && bun run db:test:migrate && bun run db:test:seed",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "^1.7.3",
    "core": "workspace:*",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "typescript": "^7.0.2"
  }
}
