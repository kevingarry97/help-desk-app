{
  "compilerOptions": {
    "target": "ES2023",
    // DOM because page.evaluate() bodies are typechecked as browser code.
    "lib": ["ES2023", "DOM"],
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["e2e", "playwright.config.ts"]
}
